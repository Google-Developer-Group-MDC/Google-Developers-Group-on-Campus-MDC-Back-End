# ─── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────
# Leave empty in development to use an in-memory MongoDB (data resets on restart).
# Required in production, e.g. a MongoDB Atlas connection string.
MONGODB_URI=

# ─── Auth ──────────────────────────────────────────────────
# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated list of front-end origins allowed to call the API
CORS_ORIGINS=https://gdg-on-campus-mdc.netlify.app,http://127.0.0.1:3000,http://localhost:3000

# ─── Email (any SMTP provider; e.g. Gmail with an App Password) ─
# Leave SMTP_HOST empty to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GDG on Campus MDC <no-reply@example.com>"
# Inbox that receives new member / partner notifications
CLUB_NOTIFY_EMAIL=

# ─── Events sync (gdg.community.dev) ───────────────────────
GDG_CHAPTER_ID=2526
GDG_CHAPTER_URL=https://gdg.community.dev/gdg-on-campus-miami-dade-college-miami-united-states/
# Cron expression for the automatic sync (default: every 6 hours). Set to "off" to disable.
EVENTS_SYNC_CRON=0 */6 * * *

# ─── First admin (used by `npm run create-admin`) ──────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
